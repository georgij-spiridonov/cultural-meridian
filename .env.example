# ==============================================================================
# Общие настройки приложения
# ==============================================================================

# Наименование сервиса (используется в метаданных, заголовках и логах)
APPLICATION_NAME=cultural-meridian

# Среда выполнения приложения
# Допустимые значения: development (разработка), production (промышленный контур), testing (тесты)
APPLICATION_ENVIRONMENT=development

# ==============================================================================
# Настройки логирования
# ==============================================================================

# Минимальный уровень сообщений, выводимых в консоль (stdout)
# Допустимые значения: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING_CONSOLE_LEVEL=INFO

# Директория для хранения файлов журналов (относительный путь от корня проекта или абсолютный путь)
LOGGING_DIRECTORY=logs

# Имя файла общего журнала работы приложения (записываются события уровня DEBUG и выше)
LOGGING_FILE_APPLICATION=application.log

# Имя файла журнала ошибок (записываются только события уровня ERROR и CRITICAL)
LOGGING_FILE_ERRORS=errors.log

# Режим открытия файлов журналов при запуске приложения
# Допустимые значения: a (дозапись в конец существующего файла), w (перезапись файла при каждом старте)
LOGGING_FILE_MODE=a

# Включение или отключение записи логов в файлы
# Допустимые значения: true (писать в консоль и в файлы), false (вывод только в консоль)
LOGGING_TO_FILE=true
