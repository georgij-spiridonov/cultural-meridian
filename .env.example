# ==============================================================================
# Общие настройки приложения
# ==============================================================================

# Наименование сервиса (используется в метаданных, заголовках и логах)
APPLICATION_NAME=cultural-meridian

# Среда выполнения приложения
# Допустимые значения: development (разработка), production (промышленный контур), testing (тесты)
APPLICATION_ENVIRONMENT=development

# ==============================================================================
# Настройки логирования
# ==============================================================================

# Минимальный уровень сообщений, выводимых в консоль (stdout)
# Допустимые значения: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGING_CONSOLE_LEVEL=INFO

# Директория для хранения файлов журналов (относительный путь от корня проекта или абсолютный путь)
LOGGING_DIRECTORY=logs

# Имя файла общего журнала работы приложения (записываются события уровня DEBUG и выше)
LOGGING_FILE_APPLICATION=application.log

# Имя файла журнала ошибок (записываются только события уровня ERROR и CRITICAL)
LOGGING_FILE_ERRORS=errors.log

# Режим открытия файлов журналов при запуске приложения
# Допустимые значения: a (дозапись в конец существующего файла), w (перезапись файла при каждом старте)
LOGGING_FILE_MODE=a

# Включение или отключение записи логов в файлы
# Допустимые значения: true (писать в консоль и в файлы), false (вывод только в консоль)
LOGGING_TO_FILE=true

# Настройки базы данных (PostgreSQL 17)
# Хост сервера PostgreSQL (при запуске в Docker Compose внутри сети используйте имя сервиса database)
DATABASE_HOST=localhost

# TCP-порт сервера PostgreSQL
DATABASE_PORT=5432

# Имя базы данных
DATABASE_NAME=cultural_meridian

# Имя пользователя базы данных
DATABASE_USER=cultural_meridian

# Пароль пользователя базы данных (локальное значение по умолчанию для разработки)
DATABASE_PASSWORD=cultural_meridian_dev

# Базовый размер пула постоянных подключений к базе данных
DATABASE_POOL_SIZE=5

# Максимальное число дополнительных подключений сверх базового пула
DATABASE_MAXIMUM_OVERFLOW=10

# Максимальное время ожидания свободного подключения из пула в секундах
DATABASE_POOL_TIMEOUT_SECONDS=30

# Включение логирования SQL-запросов движком SQLAlchemy (true / false)
DATABASE_ECHO_SQL=false

# ==============================================================================
# Настройки веб-сервера, REST API и панели модерации
# ==============================================================================

# Сетевой адрес прослушивания HTTP-сервера
WEB_HOST=0.0.0.0

# TCP-порт веб-сервера
WEB_PORT=8000

# Публичный базовый URL сервиса для генерации ссылок встраиваемого виджета
WEB_PUBLIC_BASE_URL=http://localhost:8000

# Логин встроенного модератора веб-панели /admin
WEB_ADMIN_USERNAME=moderator

# Пароль встроенного модератора для локальной разработки и демонстрации
WEB_ADMIN_PASSWORD=meridian_admin_dev

# Секрет для HMAC-подписи сессионных cookie администратора (минимум 16 символов)
WEB_SESSION_SECRET=cultural-meridian-dev-session-secret-change-me

# Время жизни сессии модератора в секундах
WEB_SESSION_TTL_SECONDS=43200

# Общий лимит HTTP-запросов в минуту с одного IP-адреса
WEB_RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Лимит отправок формы обратной связи в минуту с одного IP-адреса
WEB_FEEDBACK_RATE_LIMIT_PER_MINUTE=10

# Список разрешённых источников для CORS открытого JSON API (JSON-массив)
WEB_ALLOWED_ORIGINS=["*"]

# ==============================================================================
# Настройки Telegram-бота (aiogram v3, long polling)
# ==============================================================================

# Токен Telegram-бота (оставьте пустым для безопасного режима ожидания без подключения к API Telegram)
TELEGRAM_BOT_TOKEN=

# Количество карточек мероприятий на одной странице выдачи в чате
TELEGRAM_PAGE_SIZE=5

# Интервал проверки сигнала остановки в режиме безопасного ожидания при пустом токене (в секундах)
TELEGRAM_IDLE_POLL_SECONDS=5.0

# Публичный базовый URL веб-каталога для кнопок перехода на сайт (оставьте пустым, чтобы скрыть веб-ссылки)
TELEGRAM_PUBLIC_WEB_BASE_URL=

# Количество последних реплик, загружаемых из диалоговой сессии
TELEGRAM_DIALOG_HISTORY_LIMIT=10

# Время жизни запроса на подтверждение изменяющего действия (в секундах)
TELEGRAM_PENDING_ACTION_LIFETIME_SECONDS=600

# Интервал опроса очереди уведомлений по подпискам для отправки в Telegram (в секундах)
TELEGRAM_NOTIFICATION_POLL_INTERVAL_SECONDS=10.0

# Максимальное количество уведомлений в одном пакете отправки в Telegram
TELEGRAM_NOTIFICATION_BATCH_SIZE=50

# Максимальное число попыток доставки одного Telegram-уведомления по подписке
TELEGRAM_NOTIFICATION_MAX_ATTEMPTS=3

# Таймаут одного HTTP-запроса при отправке уведомления в Telegram (в секундах)
TELEGRAM_NOTIFICATION_REQUEST_TIMEOUT_SECONDS=5.0

# ==============================================================================
# Настройки языковой модели (OpenRouter / OpenAI Agents SDK)
# ==============================================================================

# Базовый URL OpenAI-совместимого API провайдера (по умолчанию OpenRouter)
LANGUAGE_MODEL_BASE_URL=https://openrouter.ai/api/v1

# Секретный ключ доступа к API языковой модели (оставьте пустым, чтобы не хранить секрет в шаблоне)
LANGUAGE_MODEL_API_KEY=

# Идентификатор основной модели для рассуждений, вызова инструментов и ответов пользователю
LANGUAGE_MODEL_PRIMARY=google/gemini-4-hydrogen

# Идентификатор быстрой модели для структурированного извлечения полей мероприятий
LANGUAGE_MODEL_FAST=google/gemini-3.5-flash-lite

# Таблица тарифов моделей в рублях за 1M токенов (JSON-объект с ключами input и output)
LANGUAGE_MODEL_PRICING_JSON={"google/gemini-4-hydrogen":{"input":135.0,"output":675.0},"google/gemini-3.5-flash-lite":{"input":24.0,"output":200.0}}

# Таймаут одного HTTP-запроса к языковой модели в секундах
LANGUAGE_MODEL_REQUEST_TIMEOUT_SECONDS=20.0

# Максимальное число повторных попыток при временных сбоях сети или API
LANGUAGE_MODEL_MAX_RETRIES=1

# Максимальное число шагов (вызовов инструментов) агента за один ход диалога
LANGUAGE_MODEL_MAX_AGENT_STEPS=5

# Максимальное число выходных токенов в одном ответе модели
LANGUAGE_MODEL_MAX_OUTPUT_TOKENS=8192

# Дневной лимит расходов на одного пользователя в рублях
LANGUAGE_MODEL_USER_DAILY_BUDGET_RUBLES=15.0

# Общий дневной лимит расходов всего сервиса в рублях
LANGUAGE_MODEL_GLOBAL_DAILY_BUDGET_RUBLES=250.0

# Курс пересчёта USD в RUB при использовании резервного биллинга из raw_usage
LANGUAGE_MODEL_USD_TO_RUB_RATE=85.0

# Заголовок HTTP-Referer для атрибуции запросов в OpenRouter
LANGUAGE_MODEL_HTTP_REFERER=https://cultural-meridian.local

# Заголовок X-Title для атрибуции приложения в OpenRouter
LANGUAGE_MODEL_APP_TITLE='Cultural Meridian'

# Версия системного промпта агента для аудита и трассировки
LANGUAGE_MODEL_PROMPT_VERSION=v1.0

# Использовать региональный EU-endpoint OpenRouter (eu.openrouter.ai) — требует соответствующего тарифа OpenRouter
LANGUAGE_MODEL_PREFER_EU_ENDPOINT=false

# Приоритет выбора провайдера OpenRouter (latency, throughput, price или пусто)
LANGUAGE_MODEL_PROVIDER_SORT=latency

# Использовать быструю модель (FAST) на этапе финального синтеза после вызова инструментов
LANGUAGE_MODEL_USE_FAST_SYNTHESIS_MODEL=true

# ==============================================================================
# Настройки геолокации и расчёта времени в пути
# ==============================================================================

# Путь к локальному YAML-справочнику городов и культурных площадок с координатами
GEOLOCATION_VENUES_CATALOG_PATH=configuration/venues_coordinates.yaml

# Разрешить внешние HTTP-запросы к Nominatim и OSRM при промахе локального справочника (true / false)
GEOLOCATION_EXTERNAL_ENABLED=false

# Базовый URL внешнего геокодера (Nominatim)
GEOLOCATION_GEOCODER_BASE_URL=https://nominatim.openstreetmap.org

# Базовый URL внешнего сервиса маршрутизации (OSRM)
GEOLOCATION_ROUTER_BASE_URL=https://router.project-osrm.org

# Заголовок User-Agent для запросов к внешнему геокодеру
GEOLOCATION_USER_AGENT='cultural-meridian/1.0 (+https://cultural-meridian.local)'

# Таймаут одного HTTP-запроса к внешнему геосервису в секундах
GEOLOCATION_REQUEST_TIMEOUT_SECONDS=3.0

# Максимальное количество записей в LRU-кэше координат и оценок переезда
GEOLOCATION_CACHE_MAX_ENTRIES=1024

# Средняя скорость городского транспорта (км/ч) для резервного расчёта по гаверсинусу
GEOLOCATION_AVERAGE_URBAN_SPEED_KM_PER_HOUR=25.0

# Дополнительное время на посадку и подход к транспорту в минутах
GEOLOCATION_TRANSFER_OVERHEAD_MINUTES=7

# ==============================================================================
# Настройки агента сбора данных и фонового воркера
# ==============================================================================

# Путь к YAML-реестру внешних и локальных источников афиш (относительно корня проекта или абсолютный)
INGESTION_SOURCES_CONFIG_PATH=configuration/sources.yaml

# Базовая директория локальных тестовых и офлайн-фидов источников
INGESTION_LOCAL_FEEDS_DIRECTORY=data/local_feeds

# Интервал между регулярными прогонами фонового сбора источников в секундах
INGESTION_POLL_INTERVAL_SECONDS=900

# Максимальное время ожидания HTTP-ответа при загрузке источника в секундах
INGESTION_REQUEST_TIMEOUT_SECONDS=5.0

# Максимальное время ожидания HTTP-проверки доступности ссылки события в секундах
INGESTION_LINK_CHECK_TIMEOUT_SECONDS=4.0

# Порог уверенности детерминированной нормализации для публикации без ручной модерации (0.0..1.0)
INGESTION_CONFIDENCE_THRESHOLD=0.75

# Разрешить вызов быстрой языковой модели для дозаполнения сложных или неполных полей
INGESTION_HYBRID_LLM_ENABLED=true

# Проверять существование локальных файловых ссылок на диске при офлайн-валидации фидов
INGESTION_VERIFY_LOCAL_FILE_LINKS=true

# Максимальное число сырых записей за один пакет при повторной нормализации
INGESTION_REPROCESS_BATCH_LIMIT=100

# Заголовок User-Agent для запросов фонового сборщика и проверщика ссылок
INGESTION_USER_AGENT='cultural-meridian-bot/1.0 (+https://cultural-meridian.local)'

# Максимальное число одновременных HTTP-запросов к одному сайту
INGESTION_MAX_CONCURRENT_REQUESTS_PER_HOST=2

# Пауза между HTTP-запросами к одному сайту в секундах
INGESTION_REQUEST_DELAY_SECONDS=1.0
